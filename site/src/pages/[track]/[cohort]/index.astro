---
// 코호트 첫 화면 `/g3/2028/`(T2) — 03 화면설계 2절: 머리글 + 이 코호트의 시험일·D-day, 오늘의 학습, 최근 7일, 바로가기, 구독.
// 2026-11-18 B-06. 2026-11-24 B-13: 최근 7일 = 게시 콘텐츠(content/lessons/…)에서 날짜마다 6과목 제목. 게시된 날이 하나도 없을 때만 오늘 줄에 예시 제목(demo.js).
import Base from '../../../layouts/Base.astro';
import { kstToday, tracksOn, TRACK_INFO, addDays } from '../../../lib/tracks.js';
import { loadLesson, listLessons, SUBJECTS, weekday } from '../../../lib/content.js';
import { gradeOf } from '../../../lib/calendar.js';
import DDay from '../../../components/DDay.astro';
import { DEMO_TITLES } from '../../../lib/demo.js';

export function getStaticPaths() {
  return tracksOn(kstToday()).map((t) => ({ params: { track: `g${t.grade}`, cohort: String(t.cohort) }, props: { t } }));
}
const { track, cohort } = Astro.params;
const { t } = Astro.props;
const TODAY = kstToday();
const info = TRACK_INFO[t.grade];
const lessons = listLessons(cohort);
const byDate = new Map(lessons.map((d) => [d.date, d]));
const todayL = loadLesson(cohort, track, TODAY);
const real = lessons.length > 0 || todayL.source !== 'none';
const recent = Array.from({ length: 7 }, (_, i) => addDays(TODAY, -i)).map((d) => {
  const doc = byDate.get(d);
  const day = doc ? Object.fromEntries(doc.subjects.map((x) => [x.subject, x])) : d === TODAY ? todayL.day : null;
  const has = day && Object.keys(day).length > 0;
  return {
    date: d,
    href: d === TODAY ? `/${track}/${cohort}/${d}/` : doc ? `/g${gradeOf(Number(cohort), d)}/${cohort}/${d}/` : null,
    titles: has ? SUBJECTS.map(([k]) => day[k]?.concept?.title ?? '준비 중') : d === TODAY && !real ? SUBJECTS.map(([k]) => DEMO_TITLES[t.grade][k]) : null,
  };
});
const base = `/${track}/${cohort}`;
---
<Base title={`${t.label} 코호트`}>
  <h1>{t.label}</h1>
  <p class="muted">범위: {info.scope}<br>난이도: {info.level} · 과목당 {info.count}문항</p>
  <p class="head-line"><DDay cohort={t.cohort} from={TODAY} form="long" /></p>
  <p><a class="btn big" href={`${base}/${TODAY}/`}>오늘의 학습({TODAY}) →</a></p>

  <h2>최근 7일</h2>
  {!real && <p class="demo" role="note">오늘 제목은 화면 확인용 예시입니다. 지난 날짜는 매일 게시를 시작한 뒤부터 채워집니다.</p>}
  <ul class="list recent">
    {recent.map((r) => (
      <li>
        {r.href ? <a href={r.href}>{r.date}({weekday(r.date)})</a> : <span class="muted">{r.date}({weekday(r.date)})</span>}
        {r.titles ? <span class="titles">{r.titles.join(' · ')}</span> : <span class="muted"> — 게시 전</span>}
      </li>
    ))}
  </ul>

  <h2>바로가기</h2>
  <ul class="shortcuts">
    <li><a href={`${base}/archive/`}>아카이브</a></li>
    <li><a href={`${base}/calendar/`}>시험 캘린더</a></li>
    <li><a href="/concepts/">개념 지도</a></li>
  </ul>
  <h2>구독</h2>
  <p>이 트랙 <a href={`/${track}/feed.xml`}>RSS</a> · 텔레그램 채널(<a href="/subscribe/">구독 안내</a>)</p>
</Base>
