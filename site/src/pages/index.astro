---
// 홈 `/`(M1) — 03 화면설계 1절 ①~⑥. 2026-11-18 B-06: 기준일 = 빌드한 날(KST), 트랙 카드 = 그날 코호트(tracks.js).
// 생성 콘텐츠(DATA_DIR)가 없으면 예시 제목(demo.js)을 '예시'로 표시한다 — 실데이터 연결은 B-13.
import Base from '../layouts/Base.astro';
import { loadDay, SUBJECTS, EXAMS, dday } from '../lib/content.js';
import { kstToday, slotsOn, TRACK_INFO } from '../lib/tracks.js';
import { DEMO_TITLES, DEMO_NOTICES, upcoming } from '../lib/demo.js';

const TODAY = kstToday();
const slots = slotsOn(TODAY);
const cards = slots.map((s) => {
  const day = s.active ? loadDay(`g${s.grade}`, TODAY) : {};
  const real = Object.keys(day).length > 0;
  const titles = SUBJECTS.map(([k, n]) => [n, real ? (day[k]?.concept?.title ?? '준비 중') : DEMO_TITLES[s.grade][k]]);
  return { ...s, day, real, titles };
});
const active = cards.filter((c) => c.active);
const demo = active.some((c) => !c.real);
// ① D-day 띠: 제공 코호트의 수능만, 시험 다음 날부터 빠진다(R11, 결정 9)
const cohorts = new Set(active.map((c) => c.cohort));
const band = EXAMS.filter((e) => cohorts.has(e.year) && e.date >= TODAY);
// ③ 오늘의 개념 한 줄: 트랙마다 요일별로 과목을 돌린다(P3-3)
const wd = new Date(`${TODAY}T00:00:00+09:00`).getUTCDay();
const lines = active.map((c, i) => {
  const [k, n] = SUBJECTS[(wd + i) % SUBJECTS.length];
  const text = c.real ? (c.day[k]?.concept?.summary ?? '') : `${DEMO_TITLES[c.grade][k]}(예시 — 실제 한 줄 요약은 생성 콘텐츠 연결 뒤 표시)`;
  return { tag: `고${c.grade} · ${n}`, text };
});
const schedule = upcoming(TODAY, 3);
---
<Base title="홈">
  <div class="band">{band.map((e) => <span class="chip">{e.year} 수능 <b>{dday(TODAY, e.date)}</b>({e.status})</span>)}</div>
  <p class="muted">기준일 {TODAY} · 날마다 트랙별 6과목 핵심 개념과 연습문제를 새로 씁니다.</p>
  {demo && <p class="demo" role="note">지금 보이는 과목 제목은 화면 확인용 예시입니다. 공개 전에 실제 학습 콘텐츠로 바뀝니다.</p>}

  <h2>트랙</h2>
  <div class="cards">
    {cards.map((c) => c.active
      ? (
        <section class="card">
          <h3>{c.label}</h3>
          <p class="muted">{TRACK_INFO[c.grade].level} — 오늘 6과목</p>
          <ul>{c.titles.map(([n, t]) => <li>{n}: {t}</li>)}</ul>
          <a class="btn" href={`/g${c.grade}/${c.cohort}/${TODAY}/`}>오늘의 학습 →</a>
          <a class="more" href={c.href}>트랙 안내</a>
        </section>
      )
      : (
        <section class="card off">
          <h3>{c.label}</h3>
          <p class="muted">{c.start} 시작 — {c.cohort} 수능 코호트가 고{c.grade}이 되는 날부터 매일 게시합니다.</p>
        </section>
      ))}
  </div>

  <h2>오늘의 개념 한 줄</h2>
  {lines.map((l) => <p><span class="tag">{l.tag}</span>{l.text}</p>)}

  <h2>최신 공지</h2>
  <ul class="list">{DEMO_NOTICES.map(([d, org, c, t, u]) => <li><span class="tag">{c}</span><a href={u} rel="nofollow noopener" target="_blank">{t}</a><br><span class="muted">{d} · {org}</span></li>)}</ul>
  <p class="muted">요약은 참고용입니다. 반드시 원문을 확인하세요. <a href="/notices/">전체 →</a></p>

  <h2>다가오는 일정</h2>
  <ul class="list">{schedule.map((e) => <li>{e.date} · {e.title} <span class="tag">{e.status}</span></li>)}</ul>

  <h2>구독</h2>
  <p>트랙별 RSS와 텔레그램 채널로 매일 아침 받아 보세요. <a href="/subscribe/">구독 안내 →</a></p>
</Base>
