---
// 학년도 상세 `/system/2028/`(S2) — 03 화면설계 5절 ①~⑤. 2026-11-23 B-12(계획서 61행 앞당김).
// 값은 저장소 data/exam_years.yaml·exam_systems.yaml에서만 읽는다(04 6절 — 페이지마다 손으로 쓰지 않음).
import Base from '../../../layouts/Base.astro';
import { SYSTEM_YEARS, yearRow, SUB_PAGES } from '../../../lib/system.js';
import { weekday } from '../../../lib/content.js';

export function getStaticPaths() {
  return SYSTEM_YEARS.map(({ year, system }) => ({ params: { year: String(year) }, props: { year, system } }));
}
const { year, system } = Astro.props;
const ey = yearRow(year);
const ttYear = system.years[0];             // 시험시간표는 체제 첫 학년도(2028) 공지 기준
const ttNote = year === ttYear ? null : `${year}학년도 시간표는 아직 발표되지 않았습니다. 같은 체제인 ${ttYear}학년도 시간표를 참고로 싣습니다.`;
const ttSrc = system.sources.find((s) => s.title.includes('시간표'));
---
<Base title={`${year}학년도 수능`} desc={`${year}학년도 수능 시험일·체제(영역·범위·문항·시간·평가)·시험시간표·성적 통지일과 근거 원문`}>
  <p class="crumb"><a href="/system/">수능 제도</a> › {year}학년도</p>
  <h1>{year}학년도 수능</h1>
  <p class="disclaimer" role="note">요약은 참고용입니다. 시험일·전형 일정 등은 반드시 원문(교육부·평가원·대교협·대학)을 확인하세요.</p>

  <dl class="facts">
    <div><dt>시험일</dt><dd>{ey.date}({weekday(ey.date)}) <span class:list={['st', ey.status === '확정' ? 'ok' : 'guess']}>{ey.status}</span></dd></div>
    <div><dt>성적 통지</dt><dd>{ey.score ? <>{ey.score}({weekday(ey.score)})</> : '발표 전'}</dd></div>
    <div><dt>교육과정</dt><dd>{system.curriculum}</dd></div>
    <div><dt>근거</dt><dd>{ey.source ? <a href={ey.source.url} rel="noopener" target="_blank">{ey.source.org} {ey.source.date}</a> : <span class="muted">발표 전</span>}</dd></div>
  </dl>

  <h2>체제(영역·출제 범위)</h2>
  <div class="tw">
    <table class="wide">
      <thead><tr><th>영역</th><th>출제 범위</th><th>문항</th><th>시간</th><th>평가</th></tr></thead>
      <tbody>{system.areas.map((f) => <tr><td>{f.area}</td><td class="l">{f.scope}{f.note && <><br><span class="muted">{f.note}</span></>}</td><td>{f.items}</td><td>{f.time}</td><td>{f.grade}</td></tr>)}</tbody>
    </table>
  </div>
  <p class="muted">{system.years.join('·')}학년도는 같은 체제입니다. 국어·수학 선택과목이 없고, 사회·과학탐구를 고르면 통합사회와 통합과학을 모두 봅니다.</p>

  <h2>시험시간표(일반 수험생)</h2>
  {ttNote && <p class="muted">{ttNote}</p>}
  <div class="tw">
    <table class="wide">
      <thead><tr><th>교시</th><th>영역</th><th>시각</th><th>시간</th></tr></thead>
      <tbody>{system.timetable.map((t) => <tr><td>{t.period === '-' ? '—' : `${t.period}교시`}</td><td>{t.area}</td><td>{t.time}</td><td>{t.minutes ? `${t.minutes}분` : '—'}</td></tr>)}</tbody>
    </table>
  </div>
  <p class="muted">시험편의 대상자(시각·뇌병변 등 장애 수험생)는 시간이 1.5배 또는 1.7배로 늘어납니다. 대상자 시간표는 <a href={ttSrc.url} rel="noopener" target="_blank">평가원 시험시간표 안내(일반·경증·중증) 원문</a>을 확인하세요.</p>

  <h2>더 알아보기</h2>
  <ul class="list">{SUB_PAGES.map(([slug, name, what]) => <li><a href={`/system/${year}/${slug}/`}>{name} →</a><br><span class="muted">{what}</span></li>)}</ul>

  <h2>근거 원문</h2>
  <ul class="list">
    {ey.source && <li><a href={ey.source.url} rel="noopener" target="_blank">{ey.source.org} {ey.source.date} — 시험일 발표 ↗</a></li>}
    {system.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.org} {s.date} — {s.title} ↗</a></li>)}
  </ul>
</Base>
