---
// 성적 읽는 법 `/system/2028/scores/`(S6) — 03 화면설계 5절 ①~⑤. 2026-11-23 B-12(계획서 61행 앞당김).
// 숫자는 저장소 data/grade_cuts.yaml에서 읽는다. 계산 예시는 사이트가 새로 만든 가상 수치(lib/system.js에서 계산).
import Base from '../../../../layouts/Base.astro';
import { SYSTEM_YEARS, SCORE_EXAMPLES, PERCENTILE_EXAMPLE as P, absoluteTable } from '../../../../lib/system.js';
import { GRADE_CUTS as G } from '../../../../lib/data.js';

export function getStaticPaths() {
  return SYSTEM_YEARS.map(({ year }) => ({ params: { year: String(year) }, props: { year } }));
}
const { year } = Astro.props;
const S = G.standard_score;
const R = G.relative_ratio;
const A = G.absolute_raw;
const abs = [
  ['영어', A.english, null], ['한국사', A.korean_history, null], ['제2외국어/한문', A.second_language, A.second_language.note],
];
const recentYears = [...new Set(G.recent_grade1.map((r) => r.year))].sort((a, b) => b - a);
---
<Base title={`성적 읽는 법 — ${year}학년도`} desc="수능 표준점수·백분위·등급의 뜻과 계산 예시, 상대평가 등급 비율, 최근 등급 구분 점수, 절대평가 등급 기준">
  <p class="crumb"><a href="/system/">수능 제도</a> › <a href={`/system/${year}/`}>{year}학년도</a> › 성적 읽는 법</p>
  <h1>성적 읽는 법</h1>
  <p class="disclaimer" role="note">요약은 참고용입니다. 점수 산출 방식은 평가원 원문을 확인하세요.</p>

  <h2>성적표에 나오는 세 가지</h2>
  <dl class="facts">
    <div><dt>표준점수</dt><dd>내 원점수가 평균에서 얼마나 떨어져 있는지를 같은 잣대로 바꾼 점수입니다. 국어·수학은 평균 {S.korean_math.mean}·표준편차 {S.korean_math.sd}, 탐구는 평균 {S.inquiry.mean}·표준편차 {S.inquiry.sd}로 맞춥니다. 시험이 어려울수록 같은 원점수의 표준점수가 높아지므로 '만점'이 정해져 있지 않습니다.</dd></div>
    <div><dt>백분위</dt><dd>나보다 표준점수가 낮은 수험생이 몇 %인지 나타냅니다(같은 점수 수험생은 절반만 셉니다).</dd></div>
    <div><dt>등급</dt><dd>표준점수 순서대로 정해진 비율에 따라 1~9등급을 매깁니다. 영어·한국사·제2외국어/한문은 원점수 기준으로 등급만 나옵니다(절대평가).</dd></div>
  </dl>
  <p class="muted">국어·수학·탐구는 표준점수·백분위·등급이, 영어·한국사·제2외국어/한문은 등급만 성적표에 나옵니다. 2028학년도부터 국어·수학 선택과목이 없어져 과목 사이 점수 조정 절차가 빠집니다.</p>

  <h2>계산해 보기(가상 수치)</h2>
  <p>표준점수 = (원점수 − 평균) ÷ 표준편차 × 목표 표준편차 + 목표 평균. 반올림은 마지막에 한 번만 합니다.</p>
  <div class="tw">
    <table class="wide">
      <thead><tr><th>예</th><th>원점수</th><th>그 시험 평균 · 표준편차</th><th>계산</th><th>표준점수</th></tr></thead>
      <tbody>{SCORE_EXAMPLES.map((e) => <tr><td class="l">{e.area}</td><td>{e.raw}</td><td>{e.mean} · {e.sd}</td><td class="l">({e.raw} − {e.mean}) ÷ {e.sd} = {e.z.toFixed(1)} → {e.z.toFixed(1)} × {e.sigma} + {e.mu}</td><td><b>{e.std}</b></td></tr>)}</tbody>
    </table>
  </div>
  <p>백분위 = (나보다 낮은 수험생 수 + 같은 점수 수험생 수 ÷ 2) ÷ 응시자 수 × 100. 예: 응시자 {P.n.toLocaleString()}명 중 나보다 낮은 사람 {P.below}명, 같은 점수 {P.same}명이면 ({P.below} + {P.same / 2}) ÷ {P.n.toLocaleString()} × 100 = <b>{P.pct.toFixed(1)}</b>.</p>
  <p class="muted">위 숫자는 이해를 돕기 위해 이 사이트가 만든 가상 예시이며 실제 시험 결과가 아닙니다.</p>

  <h2>상대평가 등급 비율</h2>
  <div class="tw">
    <table class="wide">
      <thead><tr><th>등급</th>{R.grade_pct.map((_, i) => <th>{i + 1}</th>)}</tr></thead>
      <tbody>
        <tr><td>비율</td>{R.grade_pct.map((p) => <td>{p}%</td>)}</tr>
        <tr><td>누적</td>{R.cumulative_pct.map((p) => <td>{p}%</td>)}</tr>
      </tbody>
    </table>
  </div>
  <p class="muted">경계에 같은 점수가 몰리면 모두 위 등급을 받으므로 실제 비율은 조금씩 달라집니다.</p>

  <h2>최근 수능 1등급 구분 점수</h2>
  {recentYears.map((y) => (
    <>
      <h3>{y}학년도</h3>
      <div class="tw">
        <table class="wide">
          <thead><tr><th>영역</th><th>기준</th><th>1등급 구분 점수</th><th>1등급 비율</th></tr></thead>
          <tbody>{G.recent_grade1.filter((r) => r.year === y).map((r) => <tr><td>{r.area}</td><td>{r.kind}</td><td>{r.cut}</td><td>{r.pct}%</td></tr>)}</tbody>
        </table>
      </div>
    </>
  ))}
  <p class="muted">절대평가인 영어도 1등급 비율은 해마다 달라집니다(2026학년도 3.11%). 2028학년도부터는 체제가 바뀌어 이전 수치와 바로 비교하기 어렵습니다. 수능 채점 결과가 발표되면(매년 12월) 갱신합니다.</p>

  <h2>절대평가 등급 기준(원점수)</h2>
  <p class="muted">{A.basis}. 2028학년도 기준은 평가원 시행기본계획(2027-03 말 예상)으로 다시 확인합니다.</p>
  <div class="tw">
    <table class="wide">
      <thead><tr><th>영역(만점)</th>{Array.from({ length: 8 }, (_, i) => <th>{i + 1}등급</th>)}<th>9등급</th></tr></thead>
      <tbody>{abs.map(([name, spec, note]) => {
        const t = absoluteTable(spec);
        return <tr><td class="l">{name}({spec.full}){note && <><br><span class="muted">{note}</span></>}</td>{t.map((r) => <td>{r.min}↑</td>)}<td>{t[7].min} 미만</td></tr>;
      })}</tbody>
    </table>
  </div>

  <h2>원문</h2>
  <ul class="list">{G.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.org} {s.date} — {s.title} ↗</a></li>)}</ul>
</Base>
