---
// 수능 제도 첫 화면 `/system/`(S1) — 03 화면설계 5절 ①~④. 2026-11-19 B-07(계획서 55행 앞당김).
// 값은 lib/system.js 한 곳에서 읽는다(B-09에서 repo\data yaml로). 학년도 상세(S2)·S5~S7은 B-12(11/26).
import Base from '../../layouts/Base.astro';
import { EXAM_YEARS, FORMAT_2028, CHANGES, SRC } from '../../lib/system.js';
import { kstToday } from '../../lib/tracks.js';
import { dday, weekday } from '../../lib/content.js';

const TODAY = kstToday();
const recent = CHANGES.slice(0, 3);
---
<Base title="수능 제도" desc="학년도별 수능 시험일(확정·예상)과 2028학년도 통합형 수능 체제 요약, 변경 이력, 기관 바로가기">
  <h1>수능 제도</h1>
  <p class="disclaimer" role="note">요약은 참고용입니다. 시험일·전형 일정 등은 반드시 원문(교육부·평가원·대교협·대학)을 확인하세요.</p>

  <h2>학년도별 시험일</h2>
  <div class="tw">
    <table class="wide">
      <thead><tr><th>학년도</th><th>시험일 · 상태</th><th>성적 통지</th><th>비고 · 근거</th></tr></thead>
      <tbody>
        {EXAM_YEARS.map((e) => (
          <tr class:list={[{ ref: e.ref }]}>
            <td>{e.year}</td>
            <td>{e.date}({weekday(e.date)}) <span class:list={['st', e.status === '확정' ? 'ok' : 'guess']}>{e.status}</span>{!e.ref && e.date >= TODAY && <><br><span class="muted">{dday(TODAY, e.date)}</span></>}</td>
            <td>{e.score ?? '—'}</td>
            <td class="l">{e.note}<br>{e.src ? <a href={SRC[e.src].url} rel="noopener" target="_blank">{SRC[e.src].org} {SRC[e.src].date}</a> : <span class="muted">발표 전</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted">2030학년도 시험일은 교육부가 그 학년도 학생이 고1일 때(보통 6~8월) 발표합니다. 발표가 감지되면 '확정'으로 바뀌고 변경 이력에 한 줄이 남습니다.</p>

  <h2>2028학년도 수능 한눈에</h2>
  <p>국어·수학·탐구의 선택과목이 없어지고, 사회·과학탐구는 통합사회와 통합과학을 <b>모두</b> 봅니다. 2029학년도도 같은 체제입니다.</p>
  <div class="tw">
    <table class="wide">
      <thead><tr><th>영역</th><th>출제 범위</th><th>문항</th><th>시간</th><th>평가</th></tr></thead>
      <tbody>{FORMAT_2028.map((f) => <tr><td>{f.area}</td><td class="l">{f.scope}</td><td>{f.items}</td><td>{f.time}</td><td>{f.grade}</td></tr>)}</tbody>
    </table>
  </div>
  <p class="muted">근거: <a href={SRC.moe2028sys.url} rel="noopener" target="_blank">교육부 2028학년도 수능 시험 및 점수 체제 안내(2025-01-21)</a>, <a href={SRC.kiceData.url} rel="noopener" target="_blank">평가원 수험자료</a>. 학년도별 시험시간표·영역별 평가 방식·성적 읽는 법·시험 당일 안내 페이지는 준비 중입니다.</p>

  <h2>최근 변경</h2>
  <ul class="list">{recent.map((c) => <li><span class="tag">{c.year}학년도</span>{c.item}: {c.after}<br><span class="muted">{c.date} · <a href={SRC[c.src].url} rel="noopener" target="_blank">{SRC[c.src].org} 원문</a></span></li>)}</ul>
  <p><a href="/system/changes/">변경 이력 전체 →</a></p>

  <h2>기관 바로가기·연간 일정</h2>
  <p>평가원·어디가 등 공식 누리집 링크와 2028학년도 연간 일정(확정·추정 구분)을 모았습니다. <a href="/system/links/">바로가기·연간 일정 →</a></p>
</Base>
