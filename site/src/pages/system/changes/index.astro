---
// 변경 이력 `/system/changes/`(S3) — 03 화면설계 5절. 최신순, 발표일·학년도·바뀐 항목·이전 → 새 값·원문. 2026-11-19 B-07, 2026-11-23 B-12 타임라인.
import Base from '../../../layouts/Base.astro';
import { CHANGES, SRC, SYSTEM_YEARS } from '../../../lib/system.js';

const rows = [...CHANGES].sort((a, b) => b.date.localeCompare(a.date));
// 타임라인(B-12, 2026-11-23): 발표 연도별로 묶어 세로선 위에 놓는다. 학년도 상세 페이지가 있으면 링크.
const groups = [...new Set(rows.map((c) => c.date.slice(0, 4)))].map((y) => [y, rows.filter((c) => c.date.startsWith(y))]);
const detail = new Set(SYSTEM_YEARS.map((x) => x.year));
---
<Base title="수능 제도 변경 이력" desc="수능 시험일·체제·일정이 바뀐 기록(발표일·이전 값·새 값·원문 링크)">
  <p class="crumb"><a href="/system/">수능 제도</a> › 변경 이력</p>
  <h1>변경 이력</h1>
  <p class="disclaimer" role="note">요약은 참고용입니다. 시험일·전형 일정 등은 반드시 원문(교육부·평가원·대교협·대학)을 확인하세요.</p>
  {groups.map(([y, list]) => (
    <section class="tl-year">
      <h2>{y}년 발표</h2>
      <ol class="timeline">
        {list.map((c) => (
          <li>
            <p class="when"><time datetime={c.date}>{c.date}</time> {detail.has(c.year) ? <a class="tag" href={`/system/${c.year}/`}>{c.year}학년도</a> : <span class="tag">{c.year}학년도</span>}<b>{c.item}</b></p>
            <p><span class="muted">이전</span> {c.before}<br><span class="muted">변경</span> {c.after}</p>
            <p class="muted">원문: <a href={SRC[c.src].url} rel="noopener" target="_blank">{SRC[c.src].org} — {SRC[c.src].title}</a></p>
          </li>
        ))}
      </ol>
    </section>
  ))}
  <p class="muted">시험일 확정처럼 사이트가 자동으로 바꾼 값도 여기에 한 줄씩 남깁니다.</p>
</Base>
